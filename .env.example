# Exchange credentials
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here

# Data
SYMBOL=BTC/USDT
TIMEFRAME=1h
SEQUENCE_LENGTH=64
TRAIN_SPLIT=0.8
VAL_SPLIT=0.1

# Training
MODEL_NAME=lstm
INPUT_SIZE=16
HIDDEN_SIZE=64
NUM_LAYERS=2
OUTPUT_SIZE=1
DROPOUT=0.1
BATCH_SIZE=32
LEARNING_RATE=0.001
EPOCHS=20

# Runtime
CHECKPOINT_DIR=checkpoints
DEVICE=cpu
STOP_LOSS_PCT=0.02
ORDER_SIZE=0.001
