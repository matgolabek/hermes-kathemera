# Exchange credentials
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_API_SECRET=your_api_secret_here

# Data
EXCHANGE=binance
SYMBOL=BTC/USDT
TIMEFRAME=1h
SINCE=2020-01-01
DATA_CACHE_DIR=data/cache
SEQUENCE_LENGTH=64
TRAIN_SPLIT=0.8
VAL_SPLIT=0.1
# LABEL_MODE=three_class: up/flat/down return over TARGET_HORIZON candles, |return| <= FLAT_THRESHOLD is flat
# LABEL_MODE=binary: down (return < -FLAT_THRESHOLD) vs rest
LABEL_MODE=three_class
TARGET_HORIZON=1
FLAT_THRESHOLD=0.002

# Training
# One of: constant, linear, mlp (baselines), lstm, gru
MODEL_NAME=lstm
INPUT_SIZE=16
HIDDEN_SIZE=64
NUM_LAYERS=2
# Number of classes: 3 for LABEL_MODE=three_class, 2 for binary (training sets it automatically)
OUTPUT_SIZE=3
DROPOUT=0.1
BATCH_SIZE=256
LEARNING_RATE=0.001
EPOCHS=20
# AdamW weight decay; stop after PATIENCE epochs without validation improvement
WEIGHT_DECAY=0.0001
PATIENCE=5
# Max gradient norm (0 disables clipping)
GRAD_CLIP=1.0
SEED=42

# Backtest: costs per unit traded (Binance spot taker fee is 0.1%), shorting, and the
# minimum predicted probability needed to open a position
FEE_RATE=0.001
SLIPPAGE=0.0005
ALLOW_SHORT=false
MIN_CONFIDENCE=0.0
# STRATEGY_RULE=argmax: act on the most likely class (long on up/rest)
# STRATEGY_RULE=exit-on-down: stay long unless P(down) > DOWN_PROB_THRESHOLD
STRATEGY_RULE=argmax
DOWN_PROB_THRESHOLD=0.5
# Instead of a fixed DOWN_PROB_THRESHOLD, exit for the top EXIT_SHARE of P(down) values
# (e.g. 0.1 = top 10%), calibrated on data before the traded period. Implies exit-on-down.
EXIT_SHARE=
# Hysteresis for EXIT_SHARE: after an exit, re-enter only once P(down) is out of its top
# REENTRY_SHARE (e.g. EXIT_SHARE=0.2, REENTRY_SHARE=0.5). Must be larger than EXIT_SHARE.
REENTRY_SHARE=

# Runtime
CHECKPOINT_DIR=checkpoints
DEVICE=cpu
STOP_LOSS_PCT=0.02
ORDER_SIZE=0.001
